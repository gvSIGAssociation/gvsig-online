#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Labels on lines"
msgstr "Etiquetas en líneas"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Follow the line (curved text)"
msgstr "Seguir la línea (texto curvo)"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Maximum bend angle"
msgstr "Ángulo máximo de curvatura"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Repeat every"
msgstr "Repetir cada"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Distance to the line"
msgstr "Distancia a la línea"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Repeat: 0 = one label per line. Distance: positive values place the label above the line."
msgstr "Repetir: 0 = una etiqueta por línea. Distancia: los valores positivos colocan la etiqueta por encima de la línea."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Labels on polygons"
msgstr "Etiquetas en polígonos"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Position"
msgstr "Posición"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Always inside the polygon"
msgstr "Siempre dentro del polígono"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Centroid (as classic labels)"
msgstr "Centroide (como las etiquetas clásicas)"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Rotation"
msgstr "Rotación"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Angle"
msgstr "Ángulo"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Angle from a field"
msgstr "Ángulo desde un campo"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "— None —"
msgstr "— Ninguno —"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Degrees, clockwise. If a field is chosen, its value is used instead of the fixed angle."
msgstr "Grados, en el sentido de las agujas del reloj. Si se elige un campo, se usa su valor en lugar del ángulo fijo."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Overlapping labels"
msgstr "Etiquetas solapadas"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Draw even if it overlaps other labels"
msgstr "Dibujar aunque se solape con otras etiquetas"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Minimum space around"
msgstr "Espacio mínimo alrededor"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Priority field"
msgstr "Campo de prioridad"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "When labels collide, those with a higher value in the priority field are drawn first."
msgstr "Cuando las etiquetas chocan, se dibujan primero las que tienen un valor mayor en el campo de prioridad."

