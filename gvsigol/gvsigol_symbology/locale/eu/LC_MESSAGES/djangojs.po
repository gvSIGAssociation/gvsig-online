#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "The web viewer (SPA) does not hide overlapping labels, so these options only affect WMS maps (GeoServer)."
msgstr "Web bisoreak (SPA) ez ditu gainjarritako etiketak ezkutatzen; beraz, aukera hauek WMS mapetan (GeoServer) bakarrik eragiten dute."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "WMS maps only"
msgstr "WMS mapak soilik"

#: static/js/lib/symbology/LabelOptionsEditor.js
