msgstr "Opacidade do preenchimento"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Border color"
msgstr "Cor do contorno"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Border width"
msgstr "Espessura do contorno"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Inner margin"
msgstr "Margem interior"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "The advanced options of this label will be discarded and it will be drawn as a classic label. Continue?"
msgstr "As opções avançadas desta etiqueta serão descartadas e será desenhada como uma etiqueta clássica. Continuar?"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Label"
msgstr "Etiqueta"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "With a background, WMS maps (GeoServer) only split the text into several lines when the label is centered without rotation or placed to the right of the point; otherwise it is drawn on a single line."
msgstr "Com fundo, os mapas WMS (GeoServer) só dividem o texto em várias linhas se a etiqueta estiver centrada e sem rotação ou à direita do ponto; caso contrário, é desenhada numa só linha."

