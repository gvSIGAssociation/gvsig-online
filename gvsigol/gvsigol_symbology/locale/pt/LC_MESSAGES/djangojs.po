msgstr "Esquerda"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Center"
msgstr "Centro"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Right"
msgstr "Direita"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Bottom left"
msgstr "Em baixo à esquerda"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Bottom"
msgstr "Em baixo"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Bottom right"
msgstr "Em baixo à direita"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Draw a box behind the label"
msgstr "Desenhar uma caixa atrás da etiqueta"

