msgid "Date format"
msgstr "Formato de data"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "e.g. \" - \" or \" inhab.\""
msgstr "p. ex. \" - \" ou \" hab.\""

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Move up"
msgstr "Mover para cima"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Move down"
msgstr "Mover para baixo"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Remove"
msgstr "Remover"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Position relative to the point"
msgstr "Posição relativamente ao ponto"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Horizontal offset"
msgstr "Deslocamento horizontal"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Vertical offset"
msgstr "Deslocamento vertical"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Positive offsets move the label right and up."
msgstr "Os deslocamentos positivos movem a etiqueta para a direita e para cima."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Labels on lines"
msgstr "Etiquetas em linhas"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Follow the line (curved text)"
msgstr "Seguir a linha (texto curvo)"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Maximum bend angle"
msgstr "Ângulo máximo de curvatura"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Repeat every"
msgstr "Repetir a cada"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Distance to the line"
msgstr "Distância à linha"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Repeat: 0 = one label per line. Distance: positive values place the label above the line."
msgstr "Repetir: 0 = uma etiqueta por linha. Distância: valores positivos colocam a etiqueta acima da linha."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Labels on polygons"
msgstr "Etiquetas em polígonos"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Position"
msgstr "Posição"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Always inside the polygon"
msgstr "Sempre dentro do polígono"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Centroid (as classic labels)"
msgstr "Centroide (como as etiquetas clássicas)"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Rotation"
msgstr "Rotação"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Angle"
msgstr "Ângulo"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Angle from a field"
msgstr "Ângulo a partir de um campo"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "— None —"
msgstr "— Nenhum —"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Degrees, clockwise. If a field is chosen, its value is used instead of the fixed angle."
msgstr "Graus, no sentido dos ponteiros do relógio. Se escolher um campo, é usado o seu valor em vez do ângulo fixo."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Overlapping labels"
msgstr "Etiquetas sobrepostas"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Draw even if it overlaps other labels"
msgstr "Desenhar mesmo que se sobreponha a outras etiquetas"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Minimum space around"
msgstr "Espaço mínimo à volta"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Priority field"
msgstr "Campo de prioridade"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "When labels collide, those with a higher value in the priority field are drawn first."
msgstr "Quando as etiquetas colidem, desenham-se primeiro as que têm um valor maior no campo de prioridade."

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
