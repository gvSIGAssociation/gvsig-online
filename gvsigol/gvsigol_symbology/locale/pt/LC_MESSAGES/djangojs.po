msgid "Format"
msgstr "Formato"

#: static/js/lib/symbology/LabelOptionsEditor.js
msgctxt "symbology"
msgid "Decimals"
msgstr "Casas decimais"

#: static/js/lib/symbology/LabelOptionsEditor.js
