#: static/js/lib/_trans.gvsigol.js:2 static/js/lib/tools/importVector.js:71
msgid "Import vector file"
msgstr "Importar arxiu vectorial"

#: static/js/lib/_trans.gvsigol.js:3
msgid "Error loading samplemenubutton plugin"
msgstr ""

#: static/js/lib/_trans.gvsigol.js:4
msgid "Could not load the layer on the map"
msgstr "No s'ha pogut carregar la capa al mapa"

#: static/js/lib/_trans.gvsigol.js:5
msgid ""
"Check that the file is valid: GeoJSON in .json or .geojson, KML or a ZIP "
"that includes a complete shapefile (.shp, .dbf, .prj, etc.)."
msgstr ""
"Comproveu que el fitxer és vàlid: GeoJSON en .json o .geojson, KML o un ZIP "
"que inclou un shapefile complet (.shp, .dbf, .prj, etc.)."

#: static/js/lib/_trans.gvsigol.js:6
msgid ""
"The ZIP includes more than one shapefile. Use a ZIP with a single complete "
"shapefile (.shp, .dbf, .prj, etc.) or load each layer separately."
msgstr ""
"El ZIP inclou més d'un shapefile. Utilitzeu un ZIP amb un sol shapefile "
"complet (.shp, .dbf, .prj, etc.) o carregueu cada capa per separat."

#: static/js/lib/tools/importVector.js:77
msgid "Vector file"
msgstr "Arxiu vectorial"

#: static/js/lib/tools/importVector.js:79
msgid "You must select a file"
msgstr "Heu de seleccionar un arxiu"

#: static/js/lib/tools/importVector.js:80
msgid "The file is too large. You can publish it from the administrator"
msgstr "El fitxer és massa gran. Podeu publicar-lo des de l'administrador"

#: static/js/lib/tools/importVector.js:85
msgid "Layer title in TOC"
msgstr "Títol de la capa al TOC"

#: static/js/lib/tools/importVector.js:87
msgid "You must indicate a title for the layer"
msgstr "Heu d'indicar un títol per a la capa"

#: static/js/lib/tools/importVector.js:93
msgid "Close"
msgstr "Tancar"

#: static/js/lib/tools/importVector.js:94
msgid "Accept"
msgstr ""

#: static/js/lib/tools/importVector.js:366
msgid "Imported vector files"
msgstr "Arxius vectorials importats"

#: static/js/lib/tools/importVector.js:444
msgid "Remove layer"
msgstr "Eliminar capa"
